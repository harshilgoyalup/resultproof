rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Institutes / Universities Collection (Maximum 4 universities allowed)
    match /institutes/{instituteId} {
      // Anyone can view registered universities in the Viewer Portal
      allow read: if true;
      
      // Only authenticated users can register a university
      allow create: if request.auth != null 
                    && request.resource.data.name is string 
                    && request.resource.data.city is string;
      
      // Updates and deletions restricted to authenticated admins
      allow update, delete: if request.auth != null;
    }

    // 2. Submissions Collection (Zero Student PII - strictly fee receipt & scorecard metadata)
    match /submissions/{submissionId} {
      // Public / Students can submit their encrypted proof
      allow create: if request.resource.data.institute_id is string
                    && request.resource.data.exam is string
                    && request.resource.data.year is int
                    && request.resource.data.fee_paid is number
                    && request.resource.data.result_value is string;
      
      // Submissions can be read or audited by authenticated users / admins
      allow read: if true;

      // Only authenticated auditors can approve/reject
      allow update: if request.auth != null;

      // Students holding submission ID or admins can delete
      allow delete: if true;
    }

    // 3. Admin Audit Logs (Append-only audit trail)
    match /admin_logs/{logId} {
      // Anyone can view audit events for transparency
      allow read: if true;
      
      // Creation allowed by authenticated users or system events
      allow create: if request.auth != null || request.resource.data.action is string;
      
      // Immutable: Never allow modification or deletion of audit logs
      allow update, delete: if false;
    }
  }
}
