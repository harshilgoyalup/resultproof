# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resultproof

# Security & JWT Auth
JWT_SECRET_KEY=replace_with_a_super_secret_64_char_key_for_production_env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage Provider: 's3', 'supabase', or 'local'
STORAGE_PROVIDER=local
STORAGE_BUCKET_NAME=resultproof-private-documents

# AWS S3 / Supabase Storage Credentials (for s3 or supabase provider)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
# S3 Endpoint URL (Required for Supabase / MinIO, leave empty for standard AWS S3)
AWS_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3

# Local storage path (when STORAGE_PROVIDER=local)
LOCAL_STORAGE_DIR=./storage_uploads

# Rate Limiting (submissions per IP per minute)
RATE_LIMIT_SUBMISSIONS_PER_MINUTE=5

# CORS Settings (Comma-separated allowed origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Minimum approved submissions to display statistics percentages
MIN_APPROVED_SUBMISSIONS_FOR_STATS=5

# Document retention days before automatic cleanup
DOCUMENT_RETENTION_DAYS=30
